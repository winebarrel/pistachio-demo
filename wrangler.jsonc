{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pistachio-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The page and the sample schemas are static assets. A request that
  // matches no asset reaches the Worker, which forwards /api/* to the
  // container and serves the page for a share link (/p/<id>).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // SHARES holds shared schemas, keyed by share ID. USAGE holds the daily
  // count of AI calls. With no id here, wrangler creates each namespace on
  // the first deploy.
  "kv_namespaces": [
    {
      "binding": "SHARES"
    },
    {
      "binding": "USAGE"
    }
  ],
  // Workers AI writes the AI examples (POST /api/example) and fixes
  // (POST /api/fix).
  "ai": {
    "binding": "AI"
  },
  // AI calls per client address: 5 a minute. The namespace_id is any
  // number unique to this account.
  "ratelimits": [
    {
      "name": "AI_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "containers": [
    {
      "class_name": "PistaContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PISTA",
        "class_name": "PistaContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PistaContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
